diff --git a/easytier-contrib/easytier-ffi/src/runtime_configs.rs b/easytier-contrib/easytier-ffi/src/runtime_configs.rs
new file mode 100644
index 0000000..bf98fea
--- /dev/null
+++ b/easytier-contrib/easytier-ffi/src/runtime_configs.rs
@@ -0,0 +1,286 @@
+use std::{
+    collections::{BTreeMap, HashSet},
+    ffi::{CStr, CString, c_char, c_int},
+    sync::Mutex,
+};
+
+use easytier::common::config::{ConfigLoader as _, TomlConfigLoader};
+use easytier_core::config::toml::ConfigSource;
+use once_cell::sync::Lazy;
+use serde_json::{Value, json};
+use uuid::Uuid;
+
+use crate::{
+    config_server::{in_config_server_callback, wait_for_config_server_delivery},
+    error::set_error_msg,
+    state::ffi_context,
+};
+
+#[derive(Clone)]
+pub(crate) struct SavedConfig {
+    pub(crate) config: TomlConfigLoader,
+    pub(crate) enabled: bool,
+}
+
+static CONFIGS: Lazy<Mutex<BTreeMap<Uuid, SavedConfig>>> =
+    Lazy::new(|| Mutex::new(BTreeMap::new()));
+
+pub(crate) fn save(config: TomlConfigLoader, enabled: bool) {
+    CONFIGS
+        .lock()
+        .unwrap()
+        .insert(config.get_id(), SavedConfig { config, enabled });
+}
+
+pub(crate) fn saved(id: Uuid) -> Option<SavedConfig> {
+    CONFIGS.lock().unwrap().get(&id).cloned()
+}
+
+pub(crate) fn disable(ids: &[Uuid]) {
+    let mut configs = CONFIGS.lock().unwrap();
+    for id in ids {
+        if let Some(saved) = configs.get_mut(id) {
+            saved.enabled = false;
+        }
+    }
+}
+
+pub(crate) fn remove(ids: &[Uuid]) {
+    let mut configs = CONFIGS.lock().unwrap();
+    for id in ids {
+        configs.remove(id);
+    }
+}
+
+pub(crate) fn remove_by_name(names: &[String]) {
+    CONFIGS
+        .lock()
+        .unwrap()
+        .retain(|_, saved| !names.contains(&saved.config.get_inst_name()));
+}
+
+pub(crate) fn retain_by_name(names: &[String]) {
+    CONFIGS
+        .lock()
+        .unwrap()
+        .retain(|_, saved| names.contains(&saved.config.get_inst_name()));
+}
+
+pub(crate) fn remove_web() {
+    CONFIGS
+        .lock()
+        .unwrap()
+        .retain(|_, saved| saved.config.get_network_config_source() != ConfigSource::Web);
+}
+
+pub(crate) fn running_web_ids() -> Vec<Uuid> {
+    let mut configs = CONFIGS.lock().unwrap();
+    ffi_context()
+        .manager
+        .instance_ids()
+        .into_iter()
+        .filter(|id| {
+            let Some(config) = ffi_context().manager.config(*id) else {
+                return false;
+            };
+            if config.get_network_config_source() != ConfigSource::Web {
+                return false;
+            }
+            configs.insert(
+                *id,
+                SavedConfig {
+                    config,
+                    enabled: true,
+                },
+            );
+            true
+        })
+        .collect()
+}
+
+fn running_tun_ids(source: ConfigSource) -> Result<Vec<Uuid>, String> {
+    let mut to_disable = Vec::new();
+    for id in ffi_context().manager.instance_ids() {
+        let Some(config) = ffi_context().manager.config(id) else {
+            continue;
+        };
+        if config.get_flags().no_tun {
+            continue;
+        }
+        if source == ConfigSource::Web && config.get_network_config_source() != ConfigSource::Web {
+            return Err(
+                "Android only supports one active TUN network; user-managed VPN remains active"
+                    .into(),
+            );
+        }
+        to_disable.push(id);
+    }
+    Ok(to_disable)
+}
+
+pub(crate) fn select_preempted_tun_ids(config: &TomlConfigLoader) -> Result<Vec<Uuid>, String> {
+    let id = config.get_id();
+    let name = config.get_inst_name();
+    if CONFIGS
+        .lock()
+        .unwrap()
+        .iter()
+        .any(|(known_id, saved)| *known_id != id && saved.config.get_inst_name() == name)
+    {
+        return Err(format!("instance name {name} already exists"));
+    }
+    if config.get_flags().no_tun {
+        Ok(Vec::new())
+    } else {
+        running_tun_ids(config.get_network_config_source())
+    }
+}
+
+// The Web hook already holds ProcessManagement's mutation lock; the local
+// equivalent runs through run_owned_network_instance_with_preemption.
+pub(crate) async fn preempt_web_tun(config: &TomlConfigLoader) -> Result<Vec<Uuid>, String> {
+    let mut ids = select_preempted_tun_ids(config)?;
+    ids.retain(|id| *id != config.get_id());
+    if ids.is_empty() {
+        return Ok(ids);
+    }
+    ffi_context()
+        .manager
+        .delete_network_instances(ids.clone())
+        .await
+        .map_err(|e| e.to_string())?;
+    crate::data_plane::remove_data_plane_sessions_by_instance_ids(&ids);
+    crate::runtime_events::stop_instances(&ids);
+    disable(&ids);
+    Ok(ids)
+}
+
+fn snapshot() -> Vec<Value> {
+    let mut configs = CONFIGS.lock().unwrap().clone();
+    for id in ffi_context().manager.instance_ids() {
+        if let Some(config) = ffi_context().manager.config(id) {
+            configs.insert(
+                id,
+                SavedConfig {
+                    config,
+                    enabled: true,
+                },
+            );
+        }
+    }
+    configs
+        .into_iter()
+        .map(|(id, saved)| {
+            let config = saved.config;
+            json!({
+                "instance_id": id.to_string(),
+                "instance_name": config.get_inst_name(),
+                "source": config.get_network_config_source().as_str(),
+                "toml_config": config.dump(),
+            "enabled": saved.enabled && ffi_context().manager.instance(id).is_some(),
+                "no_tun": config.get_flags().no_tun,
+            })
+        })
+        .collect()
+}
+
+pub(crate) unsafe fn collect_runtime_configs(out_json: *mut *const c_char) -> c_int {
+    if in_config_server_callback() || out_json.is_null() {
+        set_error_msg("cannot collect runtime configs from callback or with null output");
+        return -1;
+    }
+    unsafe {
+        *out_json = std::ptr::null();
+    }
+    wait_for_config_server_delivery();
+    let items = ffi_context().runtime.block_on(
+        ffi_context()
+            .process_management
+            .with_mutation_lock(snapshot),
+    );
+    let encoded = CString::new(Value::Array(items).to_string()).unwrap();
+    unsafe {
+        *out_json = encoded.into_raw();
+    }
+    0
+}
+
+pub(crate) unsafe fn restore_runtime_configs(json_str: *const c_char) -> c_int {
+    if in_config_server_callback() || json_str.is_null() {
+        set_error_msg("cannot restore runtime configs from callback or with null input");
+        return -1;
+    }
+    wait_for_config_server_delivery();
+    if !ffi_context().manager.instance_ids().is_empty() || !CONFIGS.lock().unwrap().is_empty() {
+        set_error_msg("restore requires an empty runtime");
+        return -1;
+    }
+    let input = match unsafe { CStr::from_ptr(json_str) }
+        .to_str()
+        .ok()
+        .and_then(|s| serde_json::from_str::<Value>(s).ok())
+    {
+        Some(Value::Array(items)) => items,
+        _ => {
+            set_error_msg("invalid runtime configs JSON array");
+            return -1;
+        }
+    };
+    let mut parsed = Vec::new();
+    let (mut ids, mut names) = (HashSet::new(), HashSet::new());
+    for item in input {
+        let Some(toml) = item.get("toml_config").and_then(Value::as_str) else {
+            set_error_msg("missing toml_config");
+            return -1;
+        };
+        let config = match TomlConfigLoader::new_from_str(toml) {
+            Ok(config) => config,
+            Err(e) => {
+                set_error_msg(&e.to_string());
+                return -1;
+            }
+        };
+        let Some(id) = item
+            .get("instance_id")
+            .and_then(Value::as_str)
+            .and_then(|id| Uuid::parse_str(id).ok())
+        else {
+            set_error_msg("invalid instance_id");
+            return -1;
+        };
+        let source = match item.get("source").and_then(Value::as_str) {
+            Some("user") => ConfigSource::User,
+            Some("web") => ConfigSource::Web,
+            _ => {
+                set_error_msg("invalid source");
+                return -1;
+            }
+        };
+        let Some(enabled) = item.get("enabled").and_then(Value::as_bool) else {
+            set_error_msg("invalid enabled");
+            return -1;
+        };
+        if !ids.insert(id) || !names.insert(config.get_inst_name()) {
+            set_error_msg("duplicate runtime config id or name");
+            return -1;
+        }
+        config.set_id(id);
+        config.set_network_config_source(Some(source));
+        parsed.push((config, enabled));
+    }
+    for (config, enabled) in parsed {
+        if enabled {
+            let toml = CString::new(config.dump()).unwrap();
+            let source = i32::from(config.get_network_config_source() == ConfigSource::Web);
+            if unsafe {
+                crate::instance_api::run_network_instance_with_source(toml.as_ptr(), source)
+            } != 0
+            {
+                return -1;
+            }
+        } else {
+            save(config, false);
+        }
+    }
+    0
+}
