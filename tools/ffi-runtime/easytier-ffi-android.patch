+    /// Runs a caller-owned instance and its host-specific preemption policy in
+    /// the same transaction as remote-managed Web starts.
+    pub async fn run_owned_network_instance_with_preemption(
+        &self,
+        config: TomlConfig,
+        control: ConfigFileControl,
+        select_preempted: impl FnOnce() -> anyhow::Result<Vec<uuid::Uuid>>,
+    ) -> anyhow::Result<(uuid::Uuid, Vec<uuid::Uuid>)> {
+        let _mutation = self.mutation_lock.lock().await;
+        let instance_id = config.get_id();
+        let instance_name = config.get_inst_name();
+        let preempted = select_preempted()?;
+        if self.instances.instance(instance_id).is_some() && !preempted.contains(&instance_id) {
+            anyhow::bail!("instance {instance_id} already exists");
+        }
+        if let Some(existing) =
+            super::resolve_optional_instance_by_name(self.instances.as_ref(), &instance_name)?
+            && existing.instance_id() != instance_id
+        {
+            anyhow::bail!("instance name {instance_name} already exists");
+        }
+        if !preempted.is_empty() {
+            self.instances
+                .delete_network_instances(preempted.clone())
+                .await?;
+            self.notify_removed_instances(&preempted).await?;
+        }
+        let id = self.instances.run_network_instance(config, control)?;
+        Ok((id, preempted))
+    }
