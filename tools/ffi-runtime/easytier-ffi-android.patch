@@ -0,0 +1,173 @@
+use std::{
+    collections::HashMap,
+    ffi::{CString, c_int, c_void},
+    sync::Mutex,
+};
+
+use easytier::{
+    common::global_ctx::GlobalCtxEvent, instance::factory::subscribe_native_instance_event,
+};
+use once_cell::sync::Lazy;
+use tokio::task::JoinHandle;
+use uuid::Uuid;
+
+use crate::{
+    config_server::{ConfigServerCallbackScope, in_config_server_callback},
+    error::set_error_msg,
+    state::ffi_context,
+    types::ConfigServerEventCallback,
+};
+
+struct RuntimeEvents {
+    callback: ConfigServerEventCallback,
+    user_data: usize,
+    subscriptions: HashMap<Uuid, JoinHandle<()>>,
+}
+
+static EVENTS: Lazy<Mutex<RuntimeEvents>> = Lazy::new(|| {
+    Mutex::new(RuntimeEvents {
+        callback: None,
+        user_data: 0,
+        subscriptions: HashMap::new(),
+    })
+});
+static DELIVERY: Lazy<Mutex<()>> = Lazy::new(|| Mutex::new(()));
+
+fn emit(id: Uuid, event: &str) {
+    let _delivery = DELIVERY.lock().unwrap();
+    let (callback, user_data) = {
+        let events = EVENTS.lock().unwrap();
+        (events.callback, events.user_data)
+    };
+    let Some(callback) = callback else { return };
+    let payload = CString::new(
+        serde_json::json!({
+            "event": event, "instance_id": id.to_string(), "success": true
+        })
+        .to_string(),
+    )
+    .unwrap();
+    let _scope = ConfigServerCallbackScope::enter();
+    unsafe { callback(payload.as_ptr(), user_data as *mut c_void) };
+}
+
+pub(crate) fn register_instance(id: Uuid) {
+    let Some(instance) = ffi_context().manager.instance(id) else {
+        return;
+    };
+    let Some(mut receiver) = subscribe_native_instance_event(&instance) else {
+        return;
+    };
+    let mut events = EVENTS.lock().unwrap();
+    if let Some(old) = events.subscriptions.remove(&id) {
+        old.abort();
+    }
+    if events.callback.is_none() {
+        return;
+    }
+    let task = ffi_context().runtime.spawn(async move {
+        loop {
+            tokio::select! {
+                _ = instance.wait() => {
+                    emit(id, "instance_exited");
+                    break;
+                }
+                result = receiver.recv() => match result {
+                    Ok(GlobalCtxEvent::DhcpIpv4Changed(_, _) | GlobalCtxEvent::DhcpIpv4Conflicted(_)) => emit(id, "dhcp_ip_changed"),
+                    Ok(GlobalCtxEvent::ProxyCidrsUpdated(_, _)) => emit(id, "proxy_cidrs_updated"),
+                    Ok(GlobalCtxEvent::PeerAdded(_)
+                        | GlobalCtxEvent::PeerRemoved(_)
+                        | GlobalCtxEvent::PeerConnAdded(_)
+                        | GlobalCtxEvent::PeerConnRemoved(_)
+                        | GlobalCtxEvent::ConnectionAccepted(_, _)
+                        | GlobalCtxEvent::ConnectionError(_, _, _)
+                        | GlobalCtxEvent::ConnectError(_, _, _)) => emit(id, "peer_connections_changed"),
+                    Ok(_) => {},
+                    Err(tokio::sync::broadcast::error::RecvError::Closed) => {
+                        emit(id, "instance_exited");
+                        break;
+                    }
+                    Err(tokio::sync::broadcast::error::RecvError::Lagged(_)) => {
+                        emit(id, "event_lagged");
+                        receiver = receiver.resubscribe();
+                    }
+                }
+            }
+        }
+    });
+    events.subscriptions.insert(id, task);
+}
+
+pub(crate) fn stop_instances(ids: &[Uuid]) {
+    let mut events = EVENTS.lock().unwrap();
+    for id in ids {
+        if let Some(task) = events.subscriptions.remove(id) {
+            task.abort();
+        }
+    }
+}
+
+pub(crate) fn set_runtime_event_callback(
+    callback: ConfigServerEventCallback,
+    user_data: *mut c_void,
+) -> c_int {
+    if in_config_server_callback() {
+        set_error_msg("cannot change runtime event callback from a callback");
+        return -1;
+    }
+    // Holding DELIVERY drains the previous callback before the caller may
+    // release its user_data. No callback can start until registration ends.
+    let _delivery = DELIVERY.lock().unwrap();
+    {
+        let mut events = EVENTS.lock().unwrap();
+        for (_, task) in events.subscriptions.drain() {
+            task.abort();
+        }
+        events.callback = callback;
+        events.user_data = user_data as usize;
+    }
+    if callback.is_some() {
+        for id in ffi_context().manager.instance_ids() {
+            register_instance(id);
+        }
+    }
+    0
+}
+
+#[cfg(test)]
+mod tests {
+    use std::{
+        ffi::{CStr, c_char, c_void},
+        sync::Mutex,
+    };
+    use uuid::Uuid;
+
+    unsafe extern "C" fn record(json: *const c_char, userdata: *mut c_void) {
+        let events = unsafe { &*(userdata as *const Mutex<Vec<String>>) };
+        events
+            .lock()
+            .unwrap()
+            .push(unsafe { CStr::from_ptr(json) }.to_str().unwrap().to_owned());
+    }
+
+    #[test]
+    fn callback_delivers_uuid_and_unregister_drains() {
+        let events: Mutex<Vec<String>> = Mutex::new(Vec::new());
+        let id = Uuid::new_v4();
+        assert_eq!(
+            super::set_runtime_event_callback(Some(record), &events as *const _ as *mut c_void),
+            0
+        );
+        super::emit(id, "dhcp_ip_changed");
+        assert_eq!(
+            super::set_runtime_event_callback(None, std::ptr::null_mut()),
+            0
+        );
+        super::emit(id, "proxy_cidrs_updated");
+        let received = events.lock().unwrap();
+        assert_eq!(received.len(), 1);
+        let json: serde_json::Value = serde_json::from_str(&received[0]).unwrap();
+        assert_eq!(json["event"], "dhcp_ip_changed");
+        assert_eq!(json["instance_id"], id.to_string());
+    }
+}
